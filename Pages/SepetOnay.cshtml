@page
@model SanalTarihcim.Pages.SepetOnayModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sanal Tarihçim | Güvenli Ödeme</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .payment-container {
            max-width: 1200px;
            margin: 40px auto;
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 30px;
            padding: 0 20px;
        }
        .payment-card {
            background: #1a1a1a;
            border: 1px solid #333;
            border-radius: 15px;
            padding: 30px;
        }
        .order-summary {
            background: #111;
            border: 1px solid #d4af37;
            padding: 25px;
            border-radius: 15px;
            position: sticky;
            top: 20px;
        }
        .summary-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            border-bottom: 1px solid #222;
            padding-bottom: 10px;
        }
        .payment-notice {
            padding: 18px;
            border: 1px solid #8b6c23;
            border-radius: 8px;
            background: #252116;
            color: #e7d8aa;
            line-height: 1.6;
        }
    </style>
</head>
<body style="background: #0f0f0f;">

    <div class="main-wrapper" style="border-top-color: #d4af37;">
        <header>
            <a href="/Index" class="logo">SANAL TARİHÇİM</a>
            <nav><ul><li><a href="/Sepetim">← SEPETE GERİ DÖN</a></li></ul></nav>
        </header>

        <section class="section-title">
            <h2 style="font-family: 'Cinzel Decorative';">ÖDEME VE ONAY</h2>
            <p>Arşivlerin size açılması için son bir adım kaldı.</p>
        </section>

        <div class="payment-container">
            <div class="payment-card">
                <h3 style="color: #fff; margin-bottom: 25px; font-family: 'Cinzel';">ÖDEME DURUMU</h3>
                <p class="payment-notice">
                    Bu sitede henüz gerçek ödeme altyapısı bulunmuyor. Kart bilgisi girmeyin;
                    şu anda ödeme alınmıyor ve sipariş oluşturulmuyor.
                </p>
            </div>

            <div class="order-summary">
                <h3 style="color: #d4af37; margin-bottom: 20px; font-family: 'Cinzel';">SİPARİŞ ÖZETİ</h3>
                <div id="ozet-liste" style="max-height: 200px; overflow-y: auto; margin-bottom: 20px;"></div>
                
                <div class="summary-item">
                    <span>Toplam Belge:</span>
                    <span id="toplam-adet" style="color: #fff;">0</span>
                </div>
                <div class="summary-item" style="border-top: 1px solid #d4af37; padding-top: 15px; margin-top: 10px;">
                    <span style="font-weight: bold; color: #d4af37;">Ödeme:</span>
                    <span style="font-weight: bold; color: #fff;">Kullanılamıyor</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        function readCart() {
            const serialized = localStorage.getItem('tarihSepeti');
            if (!serialized) return [];

            try {
                const cart = JSON.parse(serialized);
                if (!Array.isArray(cart) || cart.some(item =>
                    !item || typeof item.ad !== 'string' || typeof item.resim !== 'string')) {
                    throw new TypeError('Sepet biçimi geçersiz.');
                }

                return cart;
            } catch (error) {
                console.error('Sepet verisi okunamadı.', error);
                alert('Sepet verisi bozulmuş. Sipariş özeti gösterilemiyor.');
                return [];
            }
        }

        function renderOzet() {
            const sepet = readCart();
            const ozetListe = document.getElementById('ozet-liste');
            const adetSpan = document.getElementById('toplam-adet');

            adetSpan.textContent = sepet.length;
            ozetListe.replaceChildren();

            if (sepet.length === 0) {
                window.location.href = '/Sepetim';
                return;
            }

            sepet.forEach(item => {
                const row = document.createElement('div');
                row.style.cssText = 'display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-size: 0.85rem; color: #ccc;';

                const image = document.createElement('img');
                image.src = item.resim;
                image.alt = '';
                image.style.cssText = 'width: 30px; height: 40px; border-radius: 3px;';

                const title = document.createElement('span');
                title.textContent = item.ad;
                row.append(image, title);
                ozetListe.append(row);
            });
        }

        renderOzet();
    </script>
</body>
</html>