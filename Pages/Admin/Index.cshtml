@page
@model SanalTarihcim.Pages.Admin.IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Sanal Tarihçim | Admin Panel</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body style="margin: 0; background: #0f0f0f; color: white; font-family: Arial, sans-serif;">
    <div style="display: flex; min-height: 100vh;">
        <aside style="width: 260px; background: #111; border-right: 1px solid #d4af37; padding: 30px 20px;">
            <div style="font-size: 1.6rem; font-family: 'Cinzel Decorative'; color: #d4af37; margin-bottom: 30px;">SANAL TARİHÇİM</div>
            <nav style="display: grid; gap: 12px;">
                <a href="/Admin" style="color: white; text-decoration: none; padding: 10px 12px; background: rgba(212,175,55,0.1); border-radius: 8px;">Genel Bakış</a>
                <a href="/Admin/Books" style="color: #ddd; text-decoration: none; padding: 10px 12px;">Kitaplar</a>
                <a href="/Index" style="color: #ddd; text-decoration: none; padding: 10px 12px;">Mağazayı Gör</a>
                <form method="post" asp-page-handler="Logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" style="width: 100%; text-align: left; color: #ddd; text-decoration: none; padding: 10px 12px; background: transparent; border: 0; cursor: pointer;">Çıkış</button>
                </form>
            </nav>
        </aside>

        <main style="flex: 1; padding: 40px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
                <div>
                    <h1 style="margin: 0; color: #d4af37; font-family: 'Cinzel Decorative';">Admin Paneli</h1>
                    <p style="margin: 8px 0 0; color: #aaa;">Hoş geldiniz, @Model.AdminEmail</p>
                </div>
                <a href="/Index" style="background: #d4af37; color: #111; text-decoration: none; padding: 10px 16px; border-radius: 8px; font-weight: bold;">Siteye Dön</a>
            </div>

            <div style="background: #1a1a1a; border: 1px solid #333; border-radius: 12px; padding: 20px;">
                <h3 style="margin-top: 0; color: #d4af37;">Kitap Kataloğu</h3>
                <p style="color: #ddd;">Mağazada şu anda <strong>@Model.BookCount</strong> kitap bulunuyor.</p>
                <a href="/Admin/Books" style="display: inline-block; background: #d4af37; color: #111; text-decoration: none; padding: 10px 16px; border-radius: 6px; font-weight: bold;">Kitapları Yönet</a>
            </div>
        </main>
    </div>
</body>
</html>
