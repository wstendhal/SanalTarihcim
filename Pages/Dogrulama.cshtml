@page
@model SanalTarihcim.Pages.DogrulamaModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Sanal Tarihçim | Doğrulama</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body style="display: flex; justify-content: center; align-items: center; min-height: 100vh; background: var(--parchment);">

    <div style="width: 100%; max-width: 500px; background: white; padding: 50px; border-radius: 15px; box-shadow: 0 20px 50px rgba(0,0,0,0.1); border-top: 5px solid var(--gold);">
        <div style="text-align: center; margin-bottom: 30px;">
            <h2 style="font-family: 'Cinzel Decorative'; font-size: 2rem; margin-bottom: 10px;">DOĞRULAMA</h2>
            <p style="font-family: 'Playfair Display';">E-posta adresinize gelen 6 haneli kodu girin.</p>
            <p style="font-size: 0.9rem; color: #666;">Kod gönderilen adres: <strong>@Model.Email</strong></p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
        {
            <div style="margin-bottom: 20px; padding: 12px 15px; border-radius: 8px; background: #fff3cd; color: #7a4a00; border: 1px solid #ffe69c; font-size: 0.9rem;">
                @Model.InfoMessage
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Email" value="@Model.Email" />
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

            <div style="margin-bottom: 25px;">
                <label style="display: block; margin-bottom: 8px; font-weight: bold;"><i class="fas fa-key"></i> Doğrulama Kodu</label>
                <input type="text" name="Kod" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" placeholder="6 haneli kod" maxlength="6" style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 5px; box-sizing: border-box;" required>
            </div>

            <button type="submit" class="capsule-btn" style="width: 100%; background: var(--ink); color: white; border: none; padding: 15px; font-weight: bold; cursor: pointer;">KODU DOĞRULA</button>
        </form>

    </div>

</body>
</html>
