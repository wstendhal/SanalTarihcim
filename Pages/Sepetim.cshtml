@page
@model SanalTarihcim.Pages.SepetimModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Sanal Tarihçim | Koleksiyon Sepetim</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Mevcut stillerini korudum */
        .sepet-item {
            display: flex;
            align-items: center;
            background: #1a1a1a;
            border: 1px solid #333;
            padding: 20px;
            border-radius: 10px;
            gap: 25px;
            transition: 0.3s;
            margin-bottom: 15px; /* EKLEME: Kartlar arası nefes payı */
        }
        .sepet-item:hover {
            border-color: var(--gold, #d4af37);
            transform: translateY(-2px); /* EKLEME: Hafif yukarı kayma efekti */
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
        .sepet-item img {
            width: 100px;
            height: 140px;
            object-fit: cover;
            border-radius: 5px;
            border: 1px solid var(--gold, #d4af37);
        }
        .item-details {
            flex-grow: 1;
        }
        .item-details h4 {
            color: var(--gold, #d4af37);
            font-size: 1.4rem;
            margin-bottom: 10px;
            font-family: 'Cinzel';
        }
        .item-details p {
            color: #aaa;
            font-size: 0.9rem;
            margin: 5px 0;
        }
        .delete-btn {
            background: transparent;
            color: #800000;
            border: 1px solid #800000;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 5px;
            transition: 0.3s;
        }
        .delete-btn:hover {
            background: #800000;
            color: white;
        }

        /* EKLEME: Onay butonu için özel altın parlama efekti */
        .onay-btn {
            background: #d4af37 !important; 
            color: #111 !important; 
            border: none; 
            font-weight: bold;
            transition: 0.3s;
        }
        .onay-btn:hover {
            filter: brightness(1.2);
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
        }
    </style>
</head>
<body>
    <div class="main-wrapper" style="border-top-color: var(--gold, #d4af37);">
        <header>
            <a href="/Index" class="logo">KOLEKSİYON SEPETİM</a>
            <nav><ul><li><a href="/Index">← ARAŞTIRMAYA DEVAM ET</a></li></ul></nav>
        </header>

        <section class="section-title">
            <h2 style="font-family: 'Cinzel Decorative';">SEPETİNİZDEKİ TARİHİ HAZİNELER</h2>
            <p>Seçtiğiniz belgeleri buradan yönetebilir, toplu olarak inceleyebilirsiniz.</p>
        </section>

        <div id="sepet-icerik" style="padding: 0 50px; min-height: 400px;">
            <div id="bos-sepet-mesaji" style="text-align: center; padding: 100px; border: 2px dashed var(--gold, #d4af37); opacity: 0.6; border-radius: 15px;">
                <i class="fas fa-shopping-basket fa-4x" style="color: var(--gold, #d4af37);"></i>
                <p style="margin-top: 20px; font-size: 1.5rem; font-family: 'Playfair Display';">Sepetiniz şu an boş.</p>
                <a href="/Index" class="capsule-btn" style="display: inline-flex; margin-top: 20px;">ARŞİVE GİT</a>
            </div>

            <div id="sepet-listesi" style="display: grid; grid-template-columns: 1fr; gap: 20px;">
                </div>
        </div>

        <div style="margin-top: 80px; padding: 40px; border-top: 2px solid var(--gold, #d4af37); display: flex; justify-content: space-between; align-items: center;">
            <div style="font-family: 'Cinzel'; font-size: 1.2rem;">
                Toplam Belge Sayısı: <span id="toplam-adet" style="color: var(--gold, #d4af37); font-weight: bold;">0</span>
            </div>
            <div style="display: flex; gap: 20px;">
                <button class="capsule-btn" data-action="empty-cart" style="background: #800000; color: white; border: none;">
                    <i class="fas fa-trash-alt"></i> SEPETİ TEMİZLE
                </button>
                
                <button class="capsule-btn onay-btn" data-action="checkout">
                    <i class="fas fa-check"></i> SEPETİ ONAYLA
                </button>
            </div>
        </div>
    </div>

    <script>
        function sepetiOnayla() {
            const sepet = sepetiOku();
            if(sepet.length === 0) {
                alert("Sepetiniz boş. Önce arşivden bir eser seçin.");
                return;
            }
            window.location.href = '/SepetOnay';
        }

        function sepetiBosalt() {
            if(confirm("Sepetinizdeki tüm tarihi belgeler silinecek. Emin misiniz babuş?")) {
                localStorage.removeItem('tarihSepeti');
                renderSepet();
            }
        }

        function urunSil(index) {
            const sepet = sepetiOku();
            sepet.splice(index, 1);
            localStorage.setItem('tarihSepeti', JSON.stringify(sepet));
            renderSepet();
        }

        function sepetiOku() {
            const serialized = localStorage.getItem('tarihSepeti');
            if (!serialized) return [];

            try {
                const sepet = JSON.parse(serialized);
                if (!Array.isArray(sepet) || sepet.some(item =>
                    !item || typeof item.ad !== 'string' || typeof item.resim !== 'string')) {
                    throw new TypeError('Sepet biçimi geçersiz.');
                }

                return sepet;
            } catch (error) {
                console.error('Sepet verisi okunamadı.', error);
                alert('Sepet verisi bozulmuş. Güvenlik için sepet içeriği gösterilemiyor.');
                return [];
            }
        }

        function metinliSatir(ikonSinifi, metin) {
            const satir = document.createElement('p');
            const ikon = document.createElement('i');
            ikon.className = ikonSinifi;
            satir.append(ikon, ` ${metin}`);
            return satir;
        }

        function renderSepet() {
            const sepet = sepetiOku();
            const liste = document.getElementById('sepet-listesi');
            const bosMesaj = document.getElementById('bos-sepet-mesaji');
            const adetSpan = document.getElementById('toplam-adet');

            adetSpan.textContent = sepet.length;
            liste.replaceChildren();

            if (sepet.length === 0) {
                liste.style.display = 'none';
                bosMesaj.style.display = 'block';
            } else {
                liste.style.display = 'grid';
                bosMesaj.style.display = 'none';

                sepet.forEach((item, index) => {
                    const kart = document.createElement('div');
                    kart.className = 'sepet-item';

                    const image = document.createElement('img');
                    image.src = item.resim;
                    image.alt = item.ad;

                    const details = document.createElement('div');
                    details.className = 'item-details';

                    const title = document.createElement('h4');
                    title.textContent = item.ad;
                    details.append(
                        title,
                        metinliSatir('fas fa-landmark', 'Sanal Tarihçim Arşivi'),
                        metinliSatir('fas fa-shield-alt', 'Orijinal Dijital Kopya'));

                    const deleteButton = document.createElement('button');
                    deleteButton.className = 'delete-btn';
                    deleteButton.dataset.action = 'remove-item';
                    deleteButton.dataset.index = index;
                    deleteButton.append(
                        Object.assign(document.createElement('i'), { className: 'fas fa-times' }),
                        ' Kaldır');

                    kart.append(image, details, deleteButton);
                    liste.append(kart);
                });
            }
        }

        document.addEventListener('click', event => {
            const button = event.target.closest('[data-action]');
            if (!button) return;

            if (button.dataset.action === 'empty-cart') {
                sepetiBosalt();
            } else if (button.dataset.action === 'checkout') {
                sepetiOnayla();
            } else if (button.dataset.action === 'remove-item') {
                urunSil(Number(button.dataset.index));
            }
        });

        renderSepet();
    </script>
</body>
</html>