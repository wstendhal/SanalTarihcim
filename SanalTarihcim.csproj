<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>sanal-tarihcim-local-secrets</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);SanalTarihcim.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="SanalTarihcim.Tests/**/*.cs" />
    <Content Remove="SanalTarihcim.Tests/**/*" />
    <EmbeddedResource Remove="SanalTarihcim.Tests/**/*" />
    <None Remove="SanalTarihcim.Tests/**/*" />
  </ItemGroup>


</Project>
